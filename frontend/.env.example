# Copy to .env and adjust for your environment (never commit .env).

# --- Local dev (yarn start): browser calls backend directly ---
REACT_APP_BACKEND_URL=http://localhost:8001

# --- docker-compose.beta.yml build ---
# The beta compose file builds the frontend with REACT_APP_BACKEND_URL=http://localhost:3000 so the
# browser uses same-origin requests; nginx proxies /api/ to the backend. Set REACT_APP_API_KEY in
# your shell or repo-root .env to match backend API_KEY (compose substitutes it at build time).

# Must match backend API_KEY — required for API calls (no default in the app bundle).
REACT_APP_API_KEY=trace-analyst-secret-2026
