# Copy to .env and adjust.

# --- Local Docker MongoDB (recommended if you do not install mongod) ---
# Run from repo root: docker compose -f docker-compose.mongodb.yml up -d
MONGO_URL=mongodb://localhost:27017

# --- Or MongoDB Atlas (free tier) ---
# MONGO_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

DB_NAME=trace_analyst
API_KEY=trace-analyst-secret-2026

# Optional: AI features
# GEMINI_API_KEY=
# EMERGENT_LLM_KEY=

# Optional: OSINT
# GHOSINT_API_KEY=

# Production: restrict to your frontend origin(s), comma-separated
# CORS_ORIGINS=http://localhost:3000
