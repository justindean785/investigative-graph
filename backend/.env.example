# Copy to .env and adjust.

# --- Beta / shared deploy ---
# Rotate API_KEY to a long random secret; set the same value in frontend build as REACT_APP_API_KEY
# (docker-compose.beta.yml passes it via REACT_APP_API_KEY from your environment or repo-root .env).
# Set CORS_ORIGINS to the exact browser origin(s) that will call the API, comma-separated, e.g.:
#   CORS_ORIGINS=http://localhost:3000
# For a public host use https://your-domain.com (no trailing slash).

# --- Local MongoDB (optional dev database) ---
# e.g. docker run -d -p 27017:27017 --name trace_mongo mongo:7
# Or use root docker-compose.yml (mongodb service). Integration tests use testcontainers, not this file.
MONGO_URL=mongodb://localhost:27017

# --- Or MongoDB Atlas (free tier) ---
# MONGO_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

DB_NAME=trace_analyst
# Change for any beta or production deploy (never ship the sample key).
API_KEY=trace-analyst-secret-2026

# Optional: AI features
# GEMINI_API_KEY=
# EMERGENT_LLM_KEY=

# Optional: OSINT
# GHOSINT_API_KEY=

# Restrict to your frontend origin(s). Required when browsers hit the API from another origin.
# docker-compose.beta.yml sets http://localhost:3000 by default; override in backend/.env if needed.
# CORS_ORIGINS=http://localhost:3000
