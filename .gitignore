# ============================================================
#  Trace Analyst — .gitignore
# ============================================================

# ── Environment files ────────────────────────────────────────
# Never commit real .env files; always commit .env.example
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
backend/.env
backend/.env.*
!backend/.env.example

# ── Node / npm / yarn ────────────────────────────────────────
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
package-lock.json
yarn-error.log
npm-debug.log*
yarn-debug.log*
.pnpm-debug.log*

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
venv/
.venv/
env/
ENV/
*.egg-info/
dist/
build/
.eggs/
pip-wheel-metadata/
*.dist-info/

# ── Production builds ────────────────────────────────────────
/build
/dist
frontend/build/
/out/
/.next/
next-env.d.ts
*.tsbuildinfo

# ── Testing & coverage ───────────────────────────────────────
/coverage
.pytest_cache/
.mypy_cache/
.dmypy.json
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover

# ── IDE and editors ──────────────────────────────────────────
.idea/
.vscode/
.cursor/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ── Emergent platform artifacts ──────────────────────────────
.emergent/
memory/
chainlit.md
.chainlit/
.ipynb_checkpoints/

# ── Deployment ───────────────────────────────────────────────
.vercel

# ── OS / system files ────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
*.pem

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/
dump.rdb

# ── Archives and large assets ────────────────────────────────
*.zip
*.tar.gz
*.tar
*.tgz
*.pack
*.deb
*.dylib

# ── Credentials and tokens ───────────────────────────────────
*token.json*
*credentials.json*
*.p12
*.pfx
*.key
service-account*.json

# ── Build caches ─────────────────────────────────────────────
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# ── Misc dev junk ────────────────────────────────────────────
.ac
/dy
agenthub/
android-sdk/
